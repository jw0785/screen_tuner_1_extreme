<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Warning Banner -->
        <LinearLayout
            android:id="@+id/warningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/warning_bg"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/warningText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/warning_conflict"
                android:textColor="@color/warning_text" />

            <Button
                android:id="@+id/btnOpenDisplaySettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_display_settings"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Master Toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/masterToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_tuner"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <!-- Brightness Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brightness"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:min="5"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/brightnessValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:gravity="end" />
        </LinearLayout>

        <!-- Color Temperature Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/color_temperature"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- Daytime -->
        <LinearLayout
            android:id="@+id/rowDaytime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/swatchDaytime"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/daytime"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/daytimeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5000K"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/daytimeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="47"
                android:progress="32" />
        </LinearLayout>

        <!-- Sunset / Evening -->
        <LinearLayout
            android:id="@+id/rowSunset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/swatchSunset"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sunset_evening"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/sunsetValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4200K"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sunsetSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="47"
                android:progress="24" />
        </LinearLayout>

        <!-- Bedtime -->
        <LinearLayout
            android:id="@+id/rowBedtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/swatchBedtime"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bedtime"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/bedtimeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3800K"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/bedtimeSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="47"
                android:progress="20" />
        </LinearLayout>

        <!-- Wake Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/wake_time"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/wakeTimeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:00"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Location Toggle -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/locationToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/use_location"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp" />

        <!-- About -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_full_name"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
